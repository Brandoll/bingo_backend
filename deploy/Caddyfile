api.play.bsdev.me {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  reverse_proxy backend:8080 {
    health_uri /actuator/health
    health_interval 30s
    health_timeout 5s
  }

  log
}
